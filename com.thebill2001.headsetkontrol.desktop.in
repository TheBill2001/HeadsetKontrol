[Desktop Entry]
Name[vi]=HeadsetKontrol
Name=HeadsetKontrol
Comment[vi]=Điều khiển tai nghe của bạn bằng HeadsetControl.
Comment=Control your headsets with HeadsetControl.
Keywords[vi]=headsetkontrol;headsetcontrol;tai nghe
Keywords=headsetkontrol;headsetcontrol;headset
Version=1.0
Exec=@KDE_INSTALL_FULL_BINDIR@/headsetkontrol@HEADSETKONTROL_DESKTOP_ARGS@
Icon=headsetkontrol
Type=Application
Terminal=false
StartupNotify=true
Categories=Qt;KDE;Utility;System;Settings
X-DBUS-ServiceName=@HK_APP_ID@
X-KDE-SubstituteUID=false
