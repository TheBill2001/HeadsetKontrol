{
    "clangd.arguments": [
        "--log=error",
        "--background-index",
        "--limit-results=1000",
        "--completion-style=bundled",
        "--header-insertion=never"
    ],
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[qml]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "theqtcompany.qt-qml"
    },
    "yaml.schemas": {
        "https://www.schemastore.org/clangd.json": "${workspaceFolder}/.clangd",
        "https://www.schemastore.org/clang-tidy.json": "${workspaceFolder}/.clang-tidy",
        "https://www.schemastore.org/clang-format-21.x.json": "${workspaceFolder}/.clang-format"
    },
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "cmake.exportCompileCommandsFile": true,
    "cmake.configureSettings": {
        "QT_QML_GENERATE_QMLLS_INI": true,
        "BUILD_TESTING": true
    },
    "cmake.buildDirectory": "${workspaceFolder}/builds/${buildKit}/${buildType}",
    "cmake.useCMakePresets": "never"
}
